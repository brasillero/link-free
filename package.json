{
  "name": "link-free",
  "version": "0.0.1",
  "description": "Tiny link-in-bio static HTML generator — semantic, SEO-first, zero JS",
  "type": "module",
  "bin": {
    "link-free": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "css": "node scripts/build-styles.mjs",
    "build": "pnpm css && tsup",
    "typecheck": "tsc --noEmit",
    "test": "pnpm css && vitest run",
    "dev": "pnpm css && vitest"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^20.14.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.1.0",
    "typescript": "^5.5.4",
    "vitest": "^1.6.0",
    "zod": "^3.25.76"
  }
}
