{
  "name": "link-free",
  "version": "0.2.0",
  "description": "Tiny link-in-bio static HTML generator - semantic, SEO-first, zero JS",
  "type": "module",
  "license": "MIT",
  "author": "brasillero",
  "repository": {
    "type": "git",
    "url": "https://github.com/brasillero/link-free.git"
  },
  "homepage": "https://github.com/brasillero/link-free",
  "keywords": [
    "link-in-bio",
    "linktree-alternative",
    "static-site",
    "seo",
    "cli"
  ],
  "bin": {
    "link-free": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "css": "node scripts/build-styles.mjs",
    "build": "pnpm css && tsup",
    "typecheck": "pnpm css && tsc --noEmit",
    "test": "pnpm css && vitest run",
    "dev": "pnpm css && vitest",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^20.14.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.1.0",
    "typescript": "^5.5.4",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "jiti": "^2.7.0",
    "zod": "^3.25.76"
  }
}
