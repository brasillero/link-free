{
  "type": "object",
  "properties": {
    "theme": {
      "type": "string",
      "enum": [
        "light",
        "dark",
        "minimal"
      ],
      "default": "light"
    },
    "tokens": {
      "type": "object",
      "properties": {
        "accent": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^<]+$"
        },
        "background": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^<]+$"
        },
        "backgroundImage": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^<]+$"
        },
        "surface": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^<]+$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^<]+$"
        },
        "font": {
          "type": "string",
          "enum": [
            "system",
            "serif",
            "mono"
          ]
        },
        "radius": {
          "type": "string",
          "enum": [
            "sm",
            "md",
            "lg",
            "full"
          ]
        },
        "avatarRadius": {
          "type": "string",
          "enum": [
            "sm",
            "md",
            "lg",
            "full"
          ]
        },
        "density": {
          "type": "string",
          "enum": [
            "compact",
            "comfortable"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/brasillero/link-free/master/schemas/link.free.config.schema.json"
}
